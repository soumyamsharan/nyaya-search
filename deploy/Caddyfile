# Caddy obtains and renews the TLS certificate for API_DOMAIN automatically and redirects HTTP to HTTPS.
{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	request_body {
		max_size 16KB
	}

	reverse_proxy api:8000
}
