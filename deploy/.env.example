# Production settings, kept only on the server (chmod 600). Never commit the filled-in copy.
API_DOMAIN=api-nyaya.duckdns.org
API_IMAGE=ghcr.io/<github-user>/nyaya-api:<tag>
POSTGRES_PASSWORD=<long random value>
POSTGRES_DB=nyaya

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=<groq key>
LLM_DAILY_CAP=500

ALLOWED_ORIGINS=https://nyaya-search.vercel.app,http://localhost:3000
RATE_LIMIT=30/minute

# CPU budget (design Decision 6)
RERANKER_BACKEND=onnx-int8
RERANK_DEPTH=20
RERANK_MAX_TOKENS=256

# Backups (scripts/backup.sh)
BACKUP_BUCKET=nyaya-backups
BACKUP_KEEP=7
