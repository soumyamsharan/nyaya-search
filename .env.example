# Copy to .env and fill in. Never commit .env.

# Database (docker-compose.yml reads POSTGRES_PASSWORD)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://nyaya@127.0.0.1:5432/nyaya

# Language model: any OpenAI-compatible endpoint.
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=<groq-hosted open model>
# Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1        LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_DAILY_CAP=500

# Models: device is auto|cpu|mps; reranker backend is torch|onnx-int8
MODEL_DEVICE=auto
RERANKER_BACKEND=torch
RERANK_DEPTH=50
RERANK_MAX_TOKENS=512

# API
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT=30/minute
TRUSTED_PROXY_IPS=127.0.0.1

# Pipeline
DATA_DIR=./data
INGEST_YEARS=2024,2025,2026
